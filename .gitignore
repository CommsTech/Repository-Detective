config/config.yaml

# Local SQLite databases
data/
data/*.db
*.db

# Scanner workspace temp files
.scanner-workspace/
scanner-workspace/

# Runner local artifact directories
runner-artifacts/
runner-work/

# Dogfood reports (may contain operator-specific details — keep local by default)
docs/dogfood-reports/*
# Sanitized, committable dogfood reports (no keys, tokens, or internal hostnames)
!docs/dogfood-reports/qdrant-redacted-local-test.md
!docs/dogfood-reports/qdrant-redacted-test-result.json
!docs/dogfood-reports/ruview-preinstall-audit.md

# Configuration overrides
config.local.yaml
config.*.local.yaml

# Docker
.dockerignore

# Temporary files
tmp/
temp/
*.tmp

# Coverage reports
coverage.out
coverage.html

# Profiling data
*.prof

# Air live reload
tmp/

# Local development
.local/

# Staged scanner binaries (large; optional for offline Docker builds)
deploy/bin/trivy
deploy/bin/grype
deploy/bin/gitleaks

# Production configuration files (contain secrets)
docker-compose.prod.yml
docker-compose.override.yml
.env
