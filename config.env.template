# Repository Detective environment template (copy to .env and edit)
REPOSITORY_DETECTIVE_GITEA_URL=https://your-gitea-server.com
REPOSITORY_DETECTIVE_GITEA_TOKEN=your-gitea-access-token-here

REPOSITORY_DETECTIVE_AI_PROVIDER=openai
REPOSITORY_DETECTIVE_AI_BASE_URL=
REPOSITORY_DETECTIVE_AI_API_KEY=your-api-key-here
REPOSITORY_DETECTIVE_AI_MODEL=gpt-4o-mini

REPOSITORY_DETECTIVE_OPENWEBUI_URL=https://your-openwebui-server.com
REPOSITORY_DETECTIVE_OPENWEBUI_TOKEN=your-openwebui-api-key-here
REPOSITORY_DETECTIVE_OPENWEBUI_MODEL=default

REPOSITORY_DETECTIVE_API_KEY=change-me-to-a-secure-random-string
REPOSITORY_DETECTIVE_WEBHOOK_SECRET=change-me-to-a-secure-random-string

REPOSITORY_DETECTIVE_PORT=8080
REPOSITORY_DETECTIVE_LOG_LEVEL=info
REPOSITORY_DETECTIVE_SKIP_STARTUP_CHECKS=false

REPOSITORY_DETECTIVE_ANALYSIS_DEPTH=3
REPOSITORY_DETECTIVE_MAX_FILE_SIZE=1048576
REPOSITORY_DETECTIVE_ENABLE_SECURITY=true
REPOSITORY_DETECTIVE_ENABLE_QUALITY=true
REPOSITORY_DETECTIVE_MAX_CONCURRENT_ANALYSES=5
REPOSITORY_DETECTIVE_ANALYSIS_TIMEOUT=300

REPOSITORY_DETECTIVE_AUTO_CREATE_ISSUES=true
REPOSITORY_DETECTIVE_MAX_ISSUES_PER_RUN=50
REPOSITORY_DETECTIVE_SKIP_LOW_SEVERITY=false
REPOSITORY_DETECTIVE_GROUP_SIMILAR_ISSUES=true

REPOSITORY_DETECTIVE_DATABASE_PATH=./data/repository-detective.db
