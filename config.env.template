# Gitea Configuration
BUGBOT_GITEA_URL=https://your-gitea-server.com
BUGBOT_GITEA_TOKEN=your-gitea-access-token-here

# AI Provider (recommended)
# Supported: openai, anthropic, openrouter, ollama, openwebui, openclaw
BUGBOT_AI_PROVIDER=openai
BUGBOT_AI_BASE_URL=
BUGBOT_AI_API_KEY=your-api-key-here
BUGBOT_AI_MODEL=gpt-4o-mini

# Legacy OpenWebUI settings (still supported — maps to ai_provider=openwebui)
BUGBOT_OPENWEBUI_URL=https://your-openwebui-server.com
BUGBOT_OPENWEBUI_TOKEN=your-openwebui-api-key-here
BUGBOT_OPENWEBUI_MODEL=default

# Security: CHANGE THESE IN PRODUCTION
BUGBOT_API_KEY=change-me-to-a-secure-random-string
BUGBOT_WEBHOOK_SECRET=change-me-to-a-secure-random-string

# Server Configuration
BUGBOT_PORT=8080
BUGBOT_LOG_LEVEL=info
BUGBOT_SKIP_STARTUP_CHECKS=false

# Analysis Settings
BUGBOT_ANALYSIS_DEPTH=3
BUGBOT_MAX_FILE_SIZE=1048576
BUGBOT_ENABLE_SECURITY=true
BUGBOT_ENABLE_QUALITY=true
BUGBOT_MAX_CONCURRENT_ANALYSES=5
BUGBOT_ANALYSIS_TIMEOUT=300

# Issue Management
BUGBOT_AUTO_CREATE_ISSUES=true
BUGBOT_MAX_ISSUES_PER_RUN=50
BUGBOT_SKIP_LOW_SEVERITY=false
BUGBOT_GROUP_SIMILAR_ISSUES=true

# Provider quick reference:
# openai      -> https://api.openai.com/v1
# anthropic   -> https://api.anthropic.com/v1
# openrouter  -> https://openrouter.ai/api/v1
# ollama      -> http://127.0.0.1:11434/v1
# openwebui   -> your OpenWebUI base URL (must include /v1 path if needed)
# openclaw    -> http://127.0.0.1:18789/v1 (enable chatCompletions in gateway config)
