# Gitea Configuration
BUGBOT_GITEA_URL=https://your-gitea-server.com
BUGBOT_GITEA_TOKEN=your-gitea-access-token-here

# OpenWebUI Configuration
BUGBOT_OPENWEBUI_URL=https://your-openwebui-server.com/api
BUGBOT_OPENWEBUI_API_KEY=your-openwebui-api-key-here
BUGBOT_OPENWEBUI_MODEL=your-preferred-model

# Security: CHANGE THESE IN PRODUCTION
# API Key for /api/v1/* endpoints (generate a secure random string)
BUGBOT_API_KEY=change-me-to-a-secure-random-string

# Webhook Secret for Gitea webhook authentication (REQUIRED in production)
# Generate with: openssl rand -hex 32
BUGBOT_WEBHOOK_SECRET=change-me-to-a-secure-random-string

# Server Configuration
BUGBOT_SERVER_HOST=0.0.0.0
BUGBOT_SERVER_PORT=8080

# Analysis Settings
BUGBOT_ANALYSIS_MAX_DEPTH=3
BUGBOT_ANALYSIS_MAX_FILE_SIZE=1048576
BUGBOT_ANALYSIS_ENABLE_SECURITY_SCAN=true
BUGBOT_ANALYSIS_ENABLE_QUALITY_CHECK=true

# Issue Management
BUGBOT_ISSUES_AUTO_CREATE=true
BUGBOT_ISSUES_MAX_PER_RUN=50
BUGBOT_ISSUES_SKIP_LOW_SEVERITY=false
BUGBOT_ISSUES_GROUP_SIMILAR=true

# ⚠️  SECURITY NOTES:
# - Never deploy with empty BUGBOT_WEBHOOK_SECRET (webhook auth will be disabled!)
# - Never deploy with default BUGBOT_API_KEY (API endpoints will be open!)
# - Use HTTPS in production (HTTP exposes tokens in plaintext)
# - Generate secrets with: openssl rand -hex 32
