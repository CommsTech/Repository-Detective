# Repository Detective environment template (copy to .env and edit)
# Prefer .env.example for the full operator surface.
# checkov:skip=CKV_SECRET_6: intentional empty/required fields for operator setup — not live secrets

# --- Required core (generate secrets; startup rejects published placeholders) ---
# openssl rand -hex 32
REPOSITORY_DETECTIVE_API_KEY=
REPOSITORY_DETECTIVE_GITEA_URL=
REPOSITORY_DETECTIVE_GITEA_TOKEN=
REPOSITORY_DETECTIVE_WEBHOOK_SECRET=
REPOSITORY_DETECTIVE_PORT=8081
REPOSITORY_DETECTIVE_LOG_LEVEL=info
REPOSITORY_DETECTIVE_SKIP_STARTUP_CHECKS=false
REPOSITORY_DETECTIVE_PUBLIC_URL=http://127.0.0.1:8081

# --- Optional AI (not required; LLM auditors off by default) ---
# REPOSITORY_DETECTIVE_ENABLE_LLM_AUDITORS=false
# REPOSITORY_DETECTIVE_AI_PROVIDER=ollama
# REPOSITORY_DETECTIVE_AI_BASE_URL=http://10.x.x.x:11434
# REPOSITORY_DETECTIVE_AI_API_KEY=
# REPOSITORY_DETECTIVE_AI_MODEL=qwen2.5-coder
# Trust a private CA for AI endpoints (safe alternative to insecure TLS skip):
# REPOSITORY_DETECTIVE_AI_CA_CERT_FILE=/etc/repository-detective/private-ca.pem

REPOSITORY_DETECTIVE_ANALYSIS_DEPTH=3
REPOSITORY_DETECTIVE_MAX_FILE_SIZE=1048576
REPOSITORY_DETECTIVE_ENABLE_SECURITY=true
REPOSITORY_DETECTIVE_ENABLE_QUALITY=true
REPOSITORY_DETECTIVE_MAX_CONCURRENT_ANALYSES=5
REPOSITORY_DETECTIVE_ANALYSIS_TIMEOUT=300

# Observe / report-only until you deliberately enable forge writes.
REPOSITORY_DETECTIVE_AUTO_CREATE_ISSUES=false
REPOSITORY_DETECTIVE_MAX_ISSUES_PER_RUN=50
REPOSITORY_DETECTIVE_SKIP_LOW_SEVERITY=false
REPOSITORY_DETECTIVE_GROUP_SIMILAR_ISSUES=true

REPOSITORY_DETECTIVE_DATABASE_PATH=./data/repository-detective.db
