# nginx reverse proxy for Repository-Detective
# Place in /etc/nginx/sites-available/repository-detective and symlink to sites-enabled.
# Replace repository-detective.commsnet.org and upstream IP with your values.

upstream repository_detective {
    server 10.0.0.50:8081;
    keepalive 8;
}

server {
    listen 80;
    server_name repository-detective.commsnet.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name repository-detective.commsnet.org;

    # ssl_certificate /etc/letsencrypt/live/repository-detective.commsnet.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/repository-detective.commsnet.org/privkey.pem;

    client_max_body_size 8m;

    location / {
        proxy_pass http://repository_detective;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }
}
