# nginx reverse proxy for Bugbot
# Place in /etc/nginx/sites-available/bugbot and symlink to sites-enabled.
# Replace bugbot.commsnet.org and upstream IP with your values.

upstream bugbot {
    server 10.0.0.50:8081;
    keepalive 8;
}

server {
    listen 80;
    server_name bugbot.commsnet.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bugbot.commsnet.org;

    # ssl_certificate /etc/letsencrypt/live/bugbot.commsnet.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/bugbot.commsnet.org/privkey.pem;

    client_max_body_size 8m;

    location / {
        proxy_pass http://bugbot;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
    }
}
