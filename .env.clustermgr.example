# Copy to .env and fill in values for docker-compose.clustermgr.yml
BUGBOT_API_KEY=change-me-to-a-secure-random-string
BUGBOT_PUBLIC_URL=https://your-tunnel-or-public-url.example.com
BUGBOT_GITEA_URL=https://git.commsnet.org
BUGBOT_GITEA_TOKEN=your-gitea-token
BUGBOT_WEBHOOK_SECRET=your-webhook-secret
BUGBOT_AI_PROVIDER=openclaw
BUGBOT_AI_BASE_URL=http://your-ai-host:8080/v1
BUGBOT_AI_API_KEY=your-ai-key
BUGBOT_AI_MODEL=your-model
BUGBOT_ENABLE_SECURITY=true
BUGBOT_ENABLE_QUALITY=true
BUGBOT_AUTO_CREATE_ISSUES=true
