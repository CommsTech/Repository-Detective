# Copy to config.yaml and/or set secrets only in .env (recommended).
# Docker Compose loads .env via env_file — REPOSITORY_DETECTIVE_* overrides these values.
#
#   cp config/config.yaml.example config/config.yaml
#   cp .env.example .env   # then edit secrets

port: "8081"
listen_host: "0.0.0.0"
log_level: "info"
startup_check_timeout: 10
api_key: ""
public_url: "http://127.0.0.1:8081"

# Auth (slice 1): api_key_only (default) or local (session login for UI; API key still works).
auth_mode: api_key_only
session_cookie_name: rd_session
session_secret: ""
session_ttl_hours: 12
csrf_enabled: true
local_admin_bootstrap_enabled: true

gitea_url: "https://git.example.com"
gitea_token: ""
webhook_secret: ""

ai_provider: "openai"
ai_base_url: ""
ai_api_key: ""
ai_model: "gpt-4o-mini"
ai_insecure_skip_tls_verify: false

# beta_standard = private beta default (low issue noise). maintainer_deep = LLM + depth 3.
# Canonical profiles: light | standard | deep | custom (beta_standard maps to standard).
scan_profile: standard
analysis_depth: 2
max_file_size: 1048576
enable_security: true
enable_quality: true

# Trivy is optional when grype is installed; missing trivy is bypassed at runtime.
enable_trivy: true
enable_grype: true
enable_gitleaks: true
# Operator-controlled gitleaks config (also ship .gitleaks.toml at repo root for clone scans).
gitleaks_config: "config/gitleaks.toml"
# Git-history secret scan (slower; labeled gitleaks-history in reports)
secret_scan_git_history_enabled: true
secret_scan_history_max_commits: 0          # 0 = full history when cloning
secret_scan_recent_commits_max: 50          # scoped / pre-install window
secret_scan_history_timeout_seconds: 600
secret_scan_history_report_only_for_preinstall: true
secret_scan_redact: true
enable_semgrep: true
enable_govulncheck: true
enable_gosec: true
enable_staticcheck: true
enable_hadolint: true
enable_checkov: true
enable_linters: true
enable_llm_auditors: false
enable_ai_risk_checks: false
enable_performance_checks: false
scanner_timeout_seconds: 180
min_issue_confidence: 0.75
health_max_findings: 80

# Learning / calibration — trains false positives into repo-scoped report_only rules.
# calibration_auto_apply: when true, safe repo-scoped recommendations apply without
# manual Accept. Security/secret/CVE rules are never auto-applied.
calibration_enabled: true
calibration_interval_hours: 24
calibration_min_findings_for_recommendation: 20
calibration_auto_apply: false

# AI recommendations — disabled by default; token-efficient when enabled.
ai_recommendations_enabled: false
ai_recommendations_max_tokens_per_scan: 1500
ai_recommendations_token_budget_per_scan: 1200
ai_recommendations_max_findings_per_scan: 15
ai_recommendations_cah_enabled: true
ai_recommendations_cah_max_candidates: 8
ai_recommendations_cah_min_uncertainty_score: 0.5
ai_recommendations_use_cah_harness: true
ai_recommendations_auto_after_scan: true
ai_recommendations_send_source_snippets: false
ai_recommendations_send_full_files: false
ai_recommendations_redact_secrets: true
ai_recommendations_redact_pii: true
ai_recommendations_advisory_only: true
ai_recommendations_require_operator_approval: true
ai_recommendations_store_prompts: false
ai_recommendations_store_responses: true
ai_recommendations_allow_preinstall: false
ai_recommendations_allow_container_scans: false
ai_recommendations_allow_repo_scans: true
ai_startup_test_enabled: false
ai_connection_test_mode: metadata_only
ai_max_tokens_per_scan: 0

# Qdrant / semantic vector dedup was removed. Issue dedup is fingerprint + SQLite forge mappings.
# See docs/AGENT_QUICKSTART.md and architecture.md.

database_enabled: true
database_driver: sqlite
database_path: ./data/repository-detective.db
ui_enabled: true
ui_base_path: /ui
scheduler_enabled: true

auto_create_issues: true
max_issues_per_run: 50
skip_low_severity: false
group_similar_issues: true
max_concurrent_analyses: 2
analysis_timeout: 900
rate_limit_per_minute: 60
skip_startup_checks: false

reporting:
  mode: high_signal
  default_issue_min_severity: high
  default_issue_min_confidence: medium
  create_issues_for_low: false
  create_issues_for_tests: false
  create_issues_for_docs: false
  create_issues_for_examples: false
  create_issues_for_generated: false
  create_issues_for_vendor: false
  include_raw_scanner_output_in_issue: false
  max_issues_per_scan: 25
  group_similar_findings: true
  allow_all_categories: true
  preserve_all_findings: true
  manual_review_can_create_issue: true
  suppressed_findings_are_auditable: true
  default_action_by_severity:
    critical: auto_issue
    high: auto_issue
    medium: manual_review
    low: report_only
    info: report_only
  category_overrides:
    secrets: auto_issue
    dependency_vulnerability: auto_issue
    license: manual_review
    code_quality: report_only
    quality: report_only
    documentation: report_only
    test_gap: report_only
    ai_risk: manual_review
  source_type_overrides:
    source: auto_issue
    config: manual_review
    dependency: auto_issue
    test: report_only
    docs: report_only
    example: report_only
    generated: suppressed_with_reason
    vendor: suppressed_with_reason

false_positive_reduction:
  enabled: true
  suppress_generated: true
  suppress_vendor: true
  suppress_minified: true
  suppress_test_fixtures: true
  suppress_docs_examples: true
  require_file_exists: true
  require_line_match: false
  lower_confidence_for_dev_dependencies: true
  lower_confidence_for_unreachable_code: true
  raise_confidence_when_multiple_scanners_agree: true

remediation_planner_enabled: true
remediation_pr_enabled: false
remediation_pr_require_approval: true
remediation_pr_require_tests: true
remediation_pr_use_runner_verification: true
remediation_pr_block_high_critical_without_manual_override: true
remediation_pr_allowed_severities:
  - low
  - medium
remediation_pr_max_files_changed: 5
remediation_pr_max_diff_lines: 300
evidence_closure_enabled: true
evidence_closure_close_issues: false

# Private beta defaults (see docs/BETA_READINESS.md)
preinstall_audit_enabled: true
preinstall_sandbox_enabled: true
preinstall_sandbox_retain_on_failure: false
preinstall_sandbox_max_repo_size_mb: 500
preinstall_sandbox_max_files: 5000
preinstall_sandbox_max_file_size_mb: 25
preinstall_sandbox_timeout_seconds: 600
preinstall_sandbox_allow_submodules: false
preinstall_sandbox_network_mode: restricted
preinstall_sandbox_readonly_workspace: true
ai_startup_test_enabled: false
notifications_enabled: false
runner_delegation_enabled: false
runner_mode: native
runner_shared_secret: ""
runner_max_concurrent_jobs: 2
runner_require_hmac: true
runner_nonce_ttl_seconds: 300
runner_allowed_job_types:
  - scan
  - sbom
  - graph
  - preinstall_audit
  - remediation_verify
  - container_image_scan

# Container image scanning (opt-in; runner-required; core never mounts Docker socket by default)
container_scanning_enabled: false
container_scan_default_policy: report_only
container_scan_create_issues: false
container_scan_require_runner: true
container_scan_allow_core_docker_socket: false
container_scan_pull_policy: if_missing
container_scan_timeout_seconds: 900
container_scan_max_image_size_mb: 4096
container_scan_generate_sbom: true
container_scan_fail_on_scanner_missing: false
container_scan_allowed_runner_labels:
  - container-scan
container_scan_allowed_registries: []
container_scan_blocked_registries: []

# OpenClaw advisory AI review (opt-in; redacted packets; advisory-only)
# AI recommendations (preferred keys; openclaw_ai_* legacy aliases still honored)
ai_recommendations_enabled: false
ai_recommendations_provider: "openclaw"
ai_recommendations_endpoint: ""
ai_recommendations_model: ""
ai_recommendations_timeout_seconds: 60
ai_recommendations_max_findings_per_scan: 25
ai_recommendations_max_tokens_per_scan: 0
ai_recommendations_send_source_snippets: false
ai_recommendations_send_full_files: false
ai_recommendations_redact_secrets: true
ai_recommendations_redact_pii: true
ai_recommendations_advisory_only: true
ai_recommendations_require_operator_approval: true
ai_recommendations_use_cah_harness: true
ai_recommendations_auto_after_scan: true
ai_recommendations_cah_enabled: true
ai_recommendations_cah_max_candidates: 10
ai_recommendations_cah_min_uncertainty_score: 0.45
ai_recommendations_token_budget_per_scan: 2000
ai_recommendations_fail_closed_on_redaction_error: true
ai_recommendations_require_strict_json: true

# Legacy OpenClaw aliases (optional; merged into ai_recommendations_* when preferred keys unset)
openclaw_ai_review_enabled: false
openclaw_ai_endpoint: ""
openclaw_ai_model: ""
openclaw_ai_timeout_seconds: 60
openclaw_ai_max_findings_per_scan: 25
openclaw_ai_max_tokens_per_scan: 0
openclaw_ai_send_source_snippets: false
openclaw_ai_send_full_files: false
openclaw_ai_redact_secrets: true
openclaw_ai_redact_pii: true
openclaw_ai_allow_preinstall: false
openclaw_ai_allow_container_scans: true
openclaw_ai_allow_repo_scans: true
openclaw_ai_require_operator_approval: true
openclaw_ai_store_prompts: false
openclaw_ai_store_responses: true
openclaw_ai_advisory_only: true

gitea_actions_test_backend_enabled: false
gitea_actions_workflow_name: repository-detective-verify.yml
gitea_actions_trigger_mode: workflow_dispatch
gitea_actions_timeout_seconds: 1800
gitea_actions_require_operator_approval: true

# Paths skipped by health/graph/static collection (fixtures + vendor noise).
skip_patterns:
  - "vendor/"
  - "testdata/"
  - "benchmark/fixture/"
  - "deployment-backups/"
  - "data/tmp/"
  - "docs/dogfood-reports/"

