# Copy to .env and edit before running docker compose.
BUGBOT_API_KEY=change-me-to-a-secure-random-string
BUGBOT_PUBLIC_URL=https://bugbot.example.com
BUGBOT_GITEA_URL=https://git.example.com
BUGBOT_GITEA_TOKEN=your-gitea-token
BUGBOT_WEBHOOK_SECRET=your-webhook-secret
BUGBOT_AI_PROVIDER=openai
BUGBOT_AI_BASE_URL=
BUGBOT_AI_API_KEY=your-ai-key
BUGBOT_AI_MODEL=gpt-4o-mini
BUGBOT_ENABLE_SECURITY=true
BUGBOT_ENABLE_QUALITY=true
BUGBOT_AUTO_CREATE_ISSUES=true
BUGBOT_SKIP_STARTUP_CHECKS=false
