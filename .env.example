# Copy to .env and edit before running docker compose.
#
# Repository Detective — Inspect. Analyze. Improve.
# Environment variables use the REPOSITORY_DETECTIVE_* prefix only.
#
# REPOSITORY_DETECTIVE_API_KEY=change-me-to-a-secure-random-string
# REPOSITORY_DETECTIVE_GITEA_URL=https://git.example.com

REPOSITORY_DETECTIVE_API_KEY=change-me-to-a-secure-random-string
# Optional: pull published image (canonical = Gitea packages; GHCR is mirror).
# RD_IMAGE=git.commsnet.org/commstech/repository-detective:all-in-one
# RD_IMAGE=ghcr.io/commstech/repository-detective:all-in-one
# ---------------------------------------------------------------------------
# Recommended NEW-INSTALL UI auth (RD-010): local session login.
# Existing deployments keep api_key_only until you opt in — runtime default is unchanged.
# REPOSITORY_DETECTIVE_AUTH_MODE=local
# REPOSITORY_DETECTIVE_SESSION_SECRET=generate-a-long-random-string
# REPOSITORY_DETECTIVE_SESSION_TTL_HOURS=12
# REPOSITORY_DETECTIVE_CSRF_ENABLED=true
# Compatibility UI mode (advanced):
# REPOSITORY_DETECTIVE_AUTH_MODE=api_key_only
# Reject API keys in URLs (recommended for new installs; default false for legacy compat):
REPOSITORY_DETECTIVE_REJECT_QUERY_STRING_API_KEY=true
REPOSITORY_DETECTIVE_WARN_QUERY_STRING_API_KEY=true
# Privacy mode (RD-007): local_only | hybrid | external_ai_enabled
REPOSITORY_DETECTIVE_PRIVACY_MODE=hybrid
# ---------------------------------------------------------------------------
# Optional local UI login (default api_key_only). Requires database + session secret.
# REPOSITORY_DETECTIVE_AUTH_MODE=local
# REPOSITORY_DETECTIVE_SESSION_SECRET=
# REPOSITORY_DETECTIVE_SESSION_TTL_HOURS=12
# REPOSITORY_DETECTIVE_CSRF_ENABLED=true
REPOSITORY_DETECTIVE_PUBLIC_URL=https://detective.example.com
REPOSITORY_DETECTIVE_GITEA_URL=https://git.example.com
REPOSITORY_DETECTIVE_GITEA_TOKEN=your-gitea-token
# GitHub (optional second forge — configure at least one of Gitea or GitHub tokens)
REPOSITORY_DETECTIVE_GITHUB_URL=https://api.github.com
REPOSITORY_DETECTIVE_GITHUB_TOKEN=
# Comma-separated orgs for bulk scan (POST /api/v1/analyze/all); user repos always included
# GITEA_SCAN_ORGS=your-org
# Include org repos in onboarding + bulk scans (comma-separated), e.g. commstech
GITEA_SCAN_ORGS=commstech
# GITHUB_SCAN_ORGS=your-org,another-org
REPOSITORY_DETECTIVE_WEBHOOK_SECRET=your-webhook-secret
# ---------------------------------------------------------------------------
# Optional AI (not required). Deterministic scanners work with LLM auditors off.
# Recommended privacy-preserving option: local Ollama / OpenAI-compatible endpoint.
# REPOSITORY_DETECTIVE_AI_PROVIDER=ollama
# REPOSITORY_DETECTIVE_AI_BASE_URL=http://10.x.x.x:11434
# REPOSITORY_DETECTIVE_AI_API_KEY=
# REPOSITORY_DETECTIVE_AI_MODEL=qwen2.5-coder
# Optional advisory AI recommendations (off until max_tokens > 0). See docs/OPENCLAW_INTEGRATION.md
# REPOSITORY_DETECTIVE_AI_RECOMMENDATIONS_ENABLED=false
# REPOSITORY_DETECTIVE_AI_RECOMMENDATIONS_PROVIDER=openclaw
# REPOSITORY_DETECTIVE_AI_RECOMMENDATIONS_ENDPOINT=http://127.0.0.1:18789/v1
# REPOSITORY_DETECTIVE_AI_RECOMMENDATIONS_MAX_TOKENS_PER_SCAN=0
# Homelab OpenClaw with self-signed TLS (never enable on internet-facing hosts):
# REPOSITORY_DETECTIVE_AI_INSECURE_SKIP_TLS_VERIFY=true
# MCP bridge (agents): REPOSITORY_DETECTIVE_BASE_URL=http://127.0.0.1:8081
# ---------------------------------------------------------------------------
REPOSITORY_DETECTIVE_ENABLE_SECURITY=true
REPOSITORY_DETECTIVE_ENABLE_QUALITY=true
# Scan profile: light | standard | deep | custom
# light = fast read-only; standard = full scan + issues; deep = AI cross-checks (needs AI config)
REPOSITORY_DETECTIVE_SCAN_PROFILE=standard
REPOSITORY_DETECTIVE_ENABLE_TRIVY=true
REPOSITORY_DETECTIVE_ENABLE_GRYPE=true
REPOSITORY_DETECTIVE_ENABLE_GITLEAKS=true
# Relative to /app in Docker (bind-mount ./config). Resolved to an absolute path at scan time.
REPOSITORY_DETECTIVE_GITLEAKS_CONFIG=config/gitleaks.toml
REPOSITORY_DETECTIVE_GITLEAKS_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_ENABLE_SEMGREP=true
REPOSITORY_DETECTIVE_SEMGREP_CONFIG=p/ci
REPOSITORY_DETECTIVE_SEMGREP_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_SEMGREP_MAX_FINDINGS=100
REPOSITORY_DETECTIVE_SEMGREP_SEVERITY_THRESHOLD=INFO
REPOSITORY_DETECTIVE_ENABLE_GOVULNCHECK=true
REPOSITORY_DETECTIVE_ENABLE_GOSEC=true
REPOSITORY_DETECTIVE_ENABLE_STATICCHECK=true
REPOSITORY_DETECTIVE_GOVULNCHECK_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_GOSEC_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_STATICCHECK_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_GO_SCANNER_MAX_FINDINGS=100
REPOSITORY_DETECTIVE_ENABLE_HADOLINT=true
REPOSITORY_DETECTIVE_ENABLE_CHECKOV=true
REPOSITORY_DETECTIVE_HADOLINT_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_CHECKOV_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_IAC_SCANNER_MAX_FINDINGS=100
REPOSITORY_DETECTIVE_ENABLE_LINTERS=true
# LLM auditors off by default. Startup does not require an AI provider unless this is true.
REPOSITORY_DETECTIVE_ENABLE_LLM_AUDITORS=false
REPOSITORY_DETECTIVE_SCANNER_TIMEOUT_SECONDS=180
REPOSITORY_DETECTIVE_ENABLE_GITEA_STATUS=false
REPOSITORY_DETECTIVE_GITEA_STATUS_CONTEXT=repository-detective/security-scan
REPOSITORY_DETECTIVE_GITEA_STATUS_FAIL_ON=high
REPOSITORY_DETECTIVE_GITEA_STATUS_WARN_ON=medium
REPOSITORY_DETECTIVE_GITEA_STATUS_INCLUDE_SCANNER_FAILURES=true
REPOSITORY_DETECTIVE_WORKSPACE_MODE=api
REPOSITORY_DETECTIVE_WORKSPACE_MAX_SIZE_MB=500
REPOSITORY_DETECTIVE_WORKSPACE_MAX_FILES=5000
REPOSITORY_DETECTIVE_WORKSPACE_ARCHIVE_TIMEOUT_SECONDS=0
REPOSITORY_DETECTIVE_MIN_ISSUE_CONFIDENCE=0.75
REPOSITORY_DETECTIVE_AUTO_CREATE_ISSUES=true
REPOSITORY_DETECTIVE_SKIP_STARTUP_CHECKS=false
REPOSITORY_DETECTIVE_DATABASE_ENABLED=true
REPOSITORY_DETECTIVE_DATABASE_DRIVER=sqlite
REPOSITORY_DETECTIVE_DATABASE_PATH=./data/repository-detective.db
REPOSITORY_DETECTIVE_DATABASE_DSN=
REPOSITORY_DETECTIVE_UI_ENABLED=true
REPOSITORY_DETECTIVE_UI_BASE_PATH=/ui
REPOSITORY_DETECTIVE_SCHEDULER_ENABLED=true
REPOSITORY_DETECTIVE_SCHEDULER_POLL_INTERVAL_SECONDS=60
REPOSITORY_DETECTIVE_SCHEDULER_MAX_CONCURRENT_SCANS=1
REPOSITORY_DETECTIVE_PREINSTALL_AUDIT_ENABLED=true
REPOSITORY_DETECTIVE_PREINSTALL_ALLOW_PRIVATE_NETWORKS=false
REPOSITORY_DETECTIVE_PREINSTALL_MAX_REPO_SIZE_MB=500
REPOSITORY_DETECTIVE_PREINSTALL_MAX_FILES=5000
REPOSITORY_DETECTIVE_PREINSTALL_TIMEOUT_SECONDS=600
REPOSITORY_DETECTIVE_PREINSTALL_MAX_FINDINGS=200
REPOSITORY_DETECTIVE_PREINSTALL_ALLOW_GIT_CLONE=true
REPOSITORY_DETECTIVE_ENABLE_HEALTH_CHECKS=true
REPOSITORY_DETECTIVE_ENABLE_TECH_DEBT_CHECKS=true
REPOSITORY_DETECTIVE_ENABLE_RELIABILITY_CHECKS=true
REPOSITORY_DETECTIVE_ENABLE_MAINTAINABILITY_CHECKS=true
REPOSITORY_DETECTIVE_ENABLE_TEST_GAP_CHECKS=true
REPOSITORY_DETECTIVE_ENABLE_PERFORMANCE_CHECKS=true
REPOSITORY_DETECTIVE_ENABLE_AI_RISK_CHECKS=false
REPOSITORY_DETECTIVE_HEALTH_MAX_FINDINGS=100
REPOSITORY_DETECTIVE_HEALTH_LARGE_FILE_LINES=1000
REPOSITORY_DETECTIVE_HEALTH_LARGE_FUNCTION_LINES=150
REPOSITORY_DETECTIVE_HEALTH_MAX_NESTING_DEPTH=5
REPOSITORY_DETECTIVE_HEALTH_MAX_FUNCTION_PARAMS=7
# Repository map / code graph
REPOSITORY_DETECTIVE_ENABLE_CODE_GRAPH=true
REPOSITORY_DETECTIVE_GRAPH_MAX_NODES=5000
REPOSITORY_DETECTIVE_GRAPH_MAX_EDGES=15000
REPOSITORY_DETECTIVE_GRAPH_TIMEOUT_SECONDS=120
REPOSITORY_DETECTIVE_GRAPH_INCLUDE_FUNCTIONS=true
REPOSITORY_DETECTIVE_GRAPH_INCLUDE_FINDINGS=true
# Runner delegation
REPOSITORY_DETECTIVE_RUNNER_DELEGATION_ENABLED=false
REPOSITORY_DETECTIVE_RUNNER_MODE=core
# REPOSITORY_DETECTIVE_RUNNER_SHARED_SECRET=
REPOSITORY_DETECTIVE_RUNNER_JOB_TIMEOUT_SECONDS=900
REPOSITORY_DETECTIVE_RUNNER_MAX_CONCURRENT_JOBS=2
REPOSITORY_DETECTIVE_RUNNER_RESULT_MAX_SIZE_MB=50
REPOSITORY_DETECTIVE_RUNNER_ARTIFACT_RETENTION_DAYS=14
# Label compatibility: dual | legacy_only | new_only
REPOSITORY_DETECTIVE_LABEL_COMPAT_MODE=dual

# Notifications (see docs/NOTIFICATIONS.md) — no email in this phase
REPOSITORY_DETECTIVE_NOTIFICATIONS_ENABLED=false
REPOSITORY_DETECTIVE_NOTIFICATION_MIN_SEVERITY=high
REPOSITORY_DETECTIVE_NOTIFICATION_COOLDOWN_SECONDS=300
REPOSITORY_DETECTIVE_TELEGRAM_ENABLED=false
# REPOSITORY_DETECTIVE_TELEGRAM_BOT_TOKEN=
# REPOSITORY_DETECTIVE_TELEGRAM_CHAT_ID=
REPOSITORY_DETECTIVE_SLACK_ENABLED=false
# REPOSITORY_DETECTIVE_SLACK_WEBHOOK_URL=
REPOSITORY_DETECTIVE_DISCORD_ENABLED=false
# REPOSITORY_DETECTIVE_DISCORD_WEBHOOK_URL=
REPOSITORY_DETECTIVE_WEBHOOK_NOTIFICATIONS_ENABLED=false
# REPOSITORY_DETECTIVE_WEBHOOK_NOTIFICATION_URL=
# REPOSITORY_DETECTIVE_WEBHOOK_NOTIFICATION_SECRET=

# Remediation planner — planning only (see docs/REMEDIATION.md)
REPOSITORY_DETECTIVE_REMEDIATION_PLANNER_ENABLED=true
REPOSITORY_DETECTIVE_REMEDIATION_MIN_SEVERITY=medium
REPOSITORY_DETECTIVE_REMEDIATION_MIN_CONFIDENCE=0.80
REPOSITORY_DETECTIVE_REMEDIATION_USE_AI=false
REPOSITORY_DETECTIVE_REMEDIATION_COMMENT_ON_ISSUE=false

# Safe remediation PRs — disabled by default (see docs/REMEDIATION_PRS.md)
REPOSITORY_DETECTIVE_REMEDIATION_PR_ENABLED=false
REPOSITORY_DETECTIVE_REMEDIATION_PR_BRANCH_PREFIX=repository-detective/fix
REPOSITORY_DETECTIVE_REMEDIATION_PR_REQUIRE_APPROVAL=true
REPOSITORY_DETECTIVE_REMEDIATION_PR_MAX_FILES_CHANGED=3
REPOSITORY_DETECTIVE_REMEDIATION_PR_MAX_DIFF_LINES=100
REPOSITORY_DETECTIVE_REMEDIATION_PR_VALIDATION_TIMEOUT_SECONDS=300

# Evidence-based closure (see docs/EVIDENCE_CLOSURE.md)
REPOSITORY_DETECTIVE_EVIDENCE_CLOSURE_ENABLED=true
REPOSITORY_DETECTIVE_EVIDENCE_CLOSURE_CLOSE_ISSUES=false
REPOSITORY_DETECTIVE_EVIDENCE_CLOSURE_COMMENT=true
REPOSITORY_DETECTIVE_EVIDENCE_CLOSURE_REQUIRE_SCANNER_SUCCESS=true
